{
    "name": "florence-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:api": "openapi-typescript ../backend/openapi.yaml -o src/api/schema.d.ts",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write . && eslint --fix ."
    },
    "dependencies": {
        "@fontsource/bricolage-grotesque": "^5.3.0",
        "@fontsource/figtree": "^5.3.0",
        "@fontsource/geist-mono": "^5.3.0",
        "@fontsource/graduate": "^5.3.0",
        "@tanstack/react-query": "^5.107.1",
        "openapi-fetch": "^0.17.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.8",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.10.1",
        "sass": "^1.108.1",
        "sharp": "^0.35.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.7",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.1.0"
    }
