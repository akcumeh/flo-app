{
  "name": "florence-api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "node scripts/spec-coverage.mjs && vitest run",
    "test:coverage-spec": "node scripts/spec-coverage.mjs",
    "test:pg": "node scripts/test-pg.mjs",
    "lint:spec": "spectral lint openapi.yaml --ruleset .spectral.yaml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/figtree": "^5.3.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express-openapi-validator": "^5.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "satori": "^0.63.2",
    "unpdf": "^2.1.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@stoplight/spectral-cli": "^6.17.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
